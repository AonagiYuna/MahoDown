{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahoDown",
  "version": "0.1.14",
  "identifier": "app.mahodown.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix src/editor-web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix src/editor-web",
    "frontendDist": "../src/editor-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MahoDown",
        "width": 720,
        "height": 520,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false,
        "backgroundColor": [244, 241, 234]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
